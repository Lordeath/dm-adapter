<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- Synthetic static include fixture with 19 parameter bindings. -->
<mapper namespace="com.example.mapper.SampleRecordMapper">
    <sql id="insertColumns">
        id,tenantId,title,sourceType,categoryName,authorName,content,status,audience,publishedAt,
        expiresAt,referenceId,referenceStatus,referenceKey,createdBy,creatorName,createdAt,updatedAt,deleted
    </sql>
    <sql id="insertValues">
        #{id},#{tenantId},#{title},#{sourceType},#{categoryName},#{authorName},#{content,jdbcType=LONGVARCHAR},#{status},#{audience},#{publishedAt,jdbcType=TIMESTAMP},
        #{expiresAt,jdbcType=TIMESTAMP},#{referenceId,jdbcType=BIGINT},#{referenceStatus,jdbcType=VARCHAR},#{referenceKey},#{createdBy,jdbcType=BIGINT},#{creatorName,jdbcType=VARCHAR},#{createdAt},#{updatedAt},#{deleted}
    </sql>
    <insert id="upsertRecord">
        INSERT INTO sample_record (<include refid="insertColumns"/>) VALUES (<include refid="insertValues"/>)
        ON DUPLICATE KEY UPDATE title = VALUES(title), content = VALUES(content), authorName = VALUES(authorName),
        expiresAt = VALUES(expiresAt), updatedAt = VALUES(updatedAt)
    </insert>
</mapper>
